# Cubito Docker settings. Copy to `.env` (git- and docker-ignored) and uncomment what you need:
#   cp .env.example .env
# `docker compose up` reads `.env` next to compose.yaml; a variable exported in your shell wins.
# Leave a variable commented out to leave it unset. Never commit real values.

# Claude login for the agents inside the container. Run `claude setup-token` on the host
# (opens the browser once) and paste the long-lived token it prints.
# CLAUDE_CODE_OAUTH_TOKEN=

# Identity agents commit with; without both, agent commits fail with "Author identity unknown".
# CUBITO_GIT_NAME=Your Name
# CUBITO_GIT_EMAIL=you@example.com

# Seals stored credentials (Linear, Jira, ...) at rest. Generate once and keep it, a new key
# cannot read what an old one sealed:  openssl rand -base64 32   (or 64 hex chars)
# CUBITO_SECRET_KEY=

# Push and open PRs/MRs from the diff view. GitHub: `gh auth token` (repo scope).
# GitLab: personal access token with api + write_repository scopes.
# GH_TOKEN=
# GITLAB_TOKEN=

# `accept` lets agents run every tool without asking and accepts Claude's bypass warning for
# you. Only the container is the sandbox: agents can then act freely on everything mounted in it.
# CUBITO_AGENT_BYPASS=accept

# `1` stops Claude Code's own nonessential traffic (telemetry, error reports, update checks).
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
