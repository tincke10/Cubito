{
  "name": "cubito-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Cubito's 3D frontend: the orcad worktree graph rendered as a navigable GPU scene",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json --disable-nested-config src"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.12.0-beta.287",
    "@xterm/xterm": "6.1.0-beta.287",
    "three": "^0.180.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "oxlint": "1.15.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "ws": "^8.21.3",
    "zod": "4.4.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "@xterm/xterm@6.1.0-beta.287": "config/patches/@xterm__xterm@6.1.0-beta.287.patch"
    }
  }
}
